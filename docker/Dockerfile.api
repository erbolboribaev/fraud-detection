# Serving image: FastAPI + ONNX Runtime + Redis client only.
# No Polars/LightGBM/training dependencies here -- the model is trained
# offline (src/train.py) and its artifacts are copied in below.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/schema.py src/predictor.py src/__init__.py ./src/
COPY api/ ./api/
COPY models/ ./models/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
